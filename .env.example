# Application environment
ENVIRONMENT=development

# PostgreSQL
POSTGRES_DB=netpulse
POSTGRES_USER=netpulse
POSTGRES_PASSWORD=change-me

# SQLAlchemy
DATABASE_URL=postgresql+psycopg2://netpulse:change-me@postgres:5432/netpulse
TEST_DATABASE_URL=postgresql+psycopg2://netpulse:change-me@postgres:5432/netpulse_test

# Authentication
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application scheduler
MONITOR_INTERVAL_SECONDS=30
SNMP_INTERVAL_SECONDS=60
DASHBOARD_BROADCAST_INTERVAL_SECONDS=5

# Correlation worker
CORRELATION_WORKER_ENABLED=false
CORRELATION_WORKER_INTERVAL_SECONDS=30
CORRELATION_WORKER_BATCH_SIZE=25
CORRELATION_WINDOW_SECONDS=900
CORRELATION_THRESHOLD=0.65
CORRELATION_MAX_CANDIDATES=25

# Network monitoring
PING_TIMEOUT_SECONDS=2

# SNMP
SNMP_PORT=1161
SNMP_TIMEOUT_SECONDS=2
SNMP_RETRIES=1

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
